<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:paddingLeft="22dp"
    android:paddingTop="5dp"
    android:paddingRight="22dp"
    >

    <LinearLayout
        android:id="@+id/llWebEngine"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/web_browser_engine_temporary_setting"
            android:textSize="16sp"
            />

        <com.google.android.material.textfield.TextInputLayout
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/web_browser_engine_temporary_setting">
            <AutoCompleteTextView
                android:id="@+id/spWebEngine"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="none" />
        </com.google.android.material.textfield.TextInputLayout>
    </LinearLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/choose_default_search_engine"
        android:textSize="16sp"
        android:layout_marginTop="20dp"
        />

    <com.google.android.material.textfield.TextInputLayout
        style="@style/Widget.Material3.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="@string/choose_default_search_engine">
        <AutoCompleteTextView
            android:id="@+id/spEngine"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="none" />
    </com.google.android.material.textfield.TextInputLayout>

    <LinearLayout
        android:id="@+id/llURL"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:visibility="gone"
        >

      <TextView
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:layout_marginTop="5dp"
          android:text="@string/url"
          android:textSize="16sp"
          />

      <com.google.android.material.textfield.TextInputLayout
          style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:hint="@string/search_engine_url_with_query_placeholder_query">
          <com.google.android.material.textfield.TextInputEditText
              android:id="@+id/etUrl"
              android:layout_width="match_parent"
              android:layout_height="wrap_content"
              android:inputType="textUri" />
      </com.google.android.material.textfield.TextInputLayout>
    </LinearLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/home_page"
        android:layout_marginTop="20dp"
        android:textSize="16sp"
        />

    <com.google.android.material.textfield.TextInputLayout
        style="@style/Widget.Material3.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="@string/home_page">
        <AutoCompleteTextView
            android:id="@+id/spHomePage"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="none" />
    </com.google.android.material.textfield.TextInputLayout>

    <LinearLayout
        android:id="@+id/llCustomHomePage"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginTop="20dp"
        android:visibility="gone"
        >

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:text="@string/custom_home_page_url"
            android:textSize="16sp"
            />

        <com.google.android.material.textfield.TextInputLayout
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/url">
            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etCustomHomePageUrl"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="textUri" />
        </com.google.android.material.textfield.TextInputLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/llHomePageLinksMode"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginTop="20dp"
        android:visibility="gone"
        >

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:text="@string/home_page_links"
            android:textSize="16sp"
            />

        <com.google.android.material.textfield.TextInputLayout
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/home_page_links">
            <AutoCompleteTextView
                android:id="@+id/spHomePageLinks"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="none" />
        </com.google.android.material.textfield.TextInputLayout>
    </LinearLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/choose_user_agent_string"
        android:textSize="16sp"
        android:layout_marginTop="20dp"
        />

    <com.google.android.material.textfield.TextInputLayout
        style="@style/Widget.Material3.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="@string/choose_user_agent_string">
        <AutoCompleteTextView
            android:id="@+id/spTitles"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="none" />
    </com.google.android.material.textfield.TextInputLayout>

    <LinearLayout
        android:id="@+id/llUAString"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:visibility="gone"
        >

      <TextView
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:layout_marginTop="5dp"
          android:text="@string/user_agent_string"
          android:textSize="16sp"
          />

      <com.google.android.material.textfield.TextInputLayout
          style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:hint="@string/edit_user_agent_string">
          <com.google.android.material.textfield.TextInputEditText
              android:id="@+id/etUAString"
              android:layout_width="match_parent"
              android:layout_height="wrap_content"
              android:inputType="textUri" />
      </com.google.android.material.textfield.TextInputLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/llAdblock"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:clickable="true"
        android:focusable="true"
        android:focusableInTouchMode="true"
        android:orientation="horizontal"
        android:paddingTop="5dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:lines="1"
            android:text="@string/toggle_ads_blocking"
            android:textSize="16sp" />

        <com.google.android.material.switchmaterial.SwitchMaterial
            android:id="@+id/scAdblock"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_weight="0"
            android:duplicateParentState="true" />
    </LinearLayout>

  <com.google.android.material.card.MaterialCardView
      style="@style/Widget.Material3.CardView.Elevated"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_marginTop="8dp"
      app:cardCornerRadius="12dp"
      app:strokeColor="?attr/colorOutlineVariant"
      app:strokeWidth="1dp">
    <LinearLayout
      android:id="@+id/llAdBlockerDetails"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:orientation="vertical"
      android:padding="12dp"
      >
    <!-- Dedicated Ad Blocking Section — expands master toggle, TV-friendly -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/adblock_section_title"
        android:textSize="15sp"
        android:textStyle="bold"
        android:paddingBottom="4dp"
        />
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/adblock_section_desc"
        android:textSize="12sp"
        android:alpha="0.7"
        android:paddingBottom="8dp"
        />
    <!-- uBlock defaults — checkboxes generated in code inside this container -->
    <LinearLayout
        android:id="@+id/llUblockLists"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        />
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="@string/adblock_custom_url_label"
        android:textSize="13sp"
        />
    <com.google.android.material.textfield.TextInputLayout
        style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="@string/adblock_custom_url_hint"
        android:nextFocusDown="@+id/btnAdBlockerUpdate">
        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/etAdBlockerListUrl"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="textUri" />
    </com.google.android.material.textfield.TextInputLayout>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="horizontal">
      <LinearLayout
          android:layout_width="0dp"
          android:layout_height="wrap_content"
          android:layout_weight="1"
          android:orientation="vertical">
        <TextView
            android:id="@+id/tvAdBlockerListInfo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="5dp"
            android:gravity="center_vertical"
            android:lines="1"
            tools:text="Last update: never"
            android:textSize="12sp"
            />
        <TextView
            android:id="@+id/tvAdBlockStats"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="5dp"
            android:textSize="12sp"
            android:alpha="0.7"
            tools:text="0 blocked (total)"
            />
      </LinearLayout>
      <com.google.android.material.button.MaterialButton
        style="@style/Widget.Material3.Button.IconButton"
          android:id="@+id/btnAdBlockerUpdate"
          android:layout_width="48dp"
          android:layout_height="48dp"
          android:layout_weight="0"
          android:contentDescription="@string/update_ad_blocker_list"
          android:nextFocusDown="@+id/spTheme"
          android:src="@drawable/ic_refresh_grey_900_24dp"
        app:icon="@drawable/ic_refresh_grey_900_24dp"
          android:background="?attr/selectableItemBackgroundBorderless"
          android:focusable="true"
          />
      <com.google.android.material.progressindicator.CircularProgressIndicator
          android:id="@+id/pbAdBlockerListLoading"
          android:layout_width="48dp"
          android:layout_height="48dp"
          android:layout_weight="0"
          android:visibility="gone"
          android:indeterminate="true" />
    </LinearLayout>
    <TextView
        android:id="@+id/tvAdBlockerError"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="#FF6B6B"
        android:visibility="gone"
        android:textSize="12sp"
        android:layout_marginTop="4dp"
        />
    </LinearLayout>
  </com.google.android.material.card.MaterialCardView>

  <LinearLayout
      android:id="@+id/llThemeSettings"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:orientation="vertical"
      android:paddingTop="5dp"
      >

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/theme"
        android:textSize="16sp"
        />

    <com.google.android.material.textfield.TextInputLayout
        style="@style/Widget.Material3.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="@string/theme"
        android:nextFocusDown="@+id/scWebViewAlgorithmicDarkeningWithDarkUiMode">
        <AutoCompleteTextView
            android:id="@+id/spTheme"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="none" />
    </com.google.android.material.textfield.TextInputLayout>
  </LinearLayout>

  <LinearLayout
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_marginTop="20dp"
      android:orientation="horizontal"
      android:paddingTop="5dp"
      >
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:ellipsize="end"
        android:lines="1"
        android:text="@string/webview_use_algorithmic_darkening_with_dark_ui_mode"
        android:textSize="16sp"
        />
    <com.google.android.material.switchmaterial.SwitchMaterial
        android:id="@+id/scWebViewAlgorithmicDarkeningWithDarkUiMode"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:nextFocusDown="@+id/scAllowAutoplayMedia"
        android:nextFocusUp="@+id/spTheme"
        android:layout_weight="0"
        />
  </LinearLayout>

  <LinearLayout
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_marginTop="20dp"
      android:orientation="horizontal"
      android:paddingTop="5dp"
      >
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:ellipsize="end"
        android:lines="1"
        android:text="@string/allow_autoplay_media"
        android:textSize="16sp"
        />
    <com.google.android.material.switchmaterial.SwitchMaterial
        android:id="@+id/scAllowAutoplayMedia"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:nextFocusDown="@+id/scWebEngineDebug"
        android:nextFocusUp="@+id/scWebViewAlgorithmicDarkeningWithDarkUiMode"
        android:layout_weight="0"
        />
  </LinearLayout>

  <LinearLayout
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_marginTop="20dp"
      android:orientation="horizontal"
      android:paddingTop="5dp"
      >
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:ellipsize="end"
        android:lines="1"
        android:text="@string/web_engine_debug"
        android:textSize="16sp"
        />
    <com.google.android.material.switchmaterial.SwitchMaterial
        android:id="@+id/scWebEngineDebug"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:nextFocusDown="@+id/scKeepScreenOn"
        android:nextFocusUp="@+id/scAllowAutoplayMedia"
        android:layout_weight="0"
        />
  </LinearLayout>

  <LinearLayout
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_marginTop="20dp"
      android:orientation="horizontal"
      android:paddingTop="5dp"
      >
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:ellipsize="end"
        android:lines="1"
        android:text="@string/toggle_keep_screen_on"
        android:textSize="16sp"
        />
    <com.google.android.material.switchmaterial.SwitchMaterial
        android:id="@+id/scKeepScreenOn"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:nextFocusDown="@+id/scNavigateWithJoystickAxes"
        android:nextFocusUp="@+id/scWebEngineDebug"
        android:layout_weight="0"
        />
  </LinearLayout>
  <LinearLayout
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_marginTop="20dp"
      android:orientation="horizontal"
      android:paddingTop="5dp"
      >
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:ellipsize="end"
        android:lines="1"
        android:text="@string/navigate_with_joystick_axes"
        android:textSize="16sp"
        />
    <com.google.android.material.switchmaterial.SwitchMaterial
        android:id="@+id/scNavigateWithJoystickAxes"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:nextFocusDown="@+id/sbCursorMaxSpeed"
        android:nextFocusUp="@+id/scKeepScreenOn"
        android:layout_weight="0"
        />
  </LinearLayout>
  <TextView
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_marginTop="20dp"
      android:text="@string/cursor_max_speed"
      android:textSize="16sp"
      />
  <LinearLayout
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:gravity="center_vertical"
      android:orientation="horizontal"
      >
    <com.google.android.material.slider.Slider
        android:id="@+id/sbCursorMaxSpeed"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:valueFrom="0"
        android:valueTo="175"
        android:stepSize="1"
        app:labelBehavior="withinBounds"
        android:nextFocusDown="@+id/sbCursorAcceleration"
        android:nextFocusUp="@+id/scNavigateWithJoystickAxes"
        />
    <TextView
        android:id="@+id/tvCursorMaxSpeedValue"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:minWidth="72dp"
        android:gravity="end"
        android:textSize="14sp"
        tools:text="100%"
        />
  </LinearLayout>
  <TextView
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_marginTop="12dp"
      android:text="@string/cursor_acceleration"
      android:textSize="16sp"
      />
  <LinearLayout
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:gravity="center_vertical"
      android:orientation="horizontal"
      >
    <com.google.android.material.slider.Slider
        android:id="@+id/sbCursorAcceleration"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:valueFrom="0"
        android:valueTo="175"
        android:stepSize="1"
        app:labelBehavior="withinBounds"
        android:nextFocusDown="@+id/btnClearWebCache"
        android:nextFocusUp="@+id/sbCursorMaxSpeed"
        />
    <TextView
        android:id="@+id/tvCursorAccelerationValue"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:minWidth="72dp"
        android:gravity="end"
        android:textSize="14sp"
        tools:text="100%"
        />
  </LinearLayout>
  <com.google.android.material.button.MaterialButton
      android:id="@+id/btnClearWebCache"
      style="@style/Widget.Material3.Button.TonalButton"
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:layout_marginTop="10dp"
      android:nextFocusUp="@+id/sbCursorAcceleration"
      android:text="@string/clear_web_cache" />
  <View
      android:layout_width="match_parent"
      android:layout_height="50dp"
      />
</LinearLayout>
