<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/activity_downloads"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    android:background="@color/day_night_background_color"
    tools:context="com.phlox.tvwebbrowser.activity.downloads.DownloadsActivity">

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/listView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:paddingBottom="16dp" />

    <TextView
        android:text="@string/nothing"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:id="@+id/tvPlaceholder"
        android:gravity="center"
        android:textColor="@color/day_night_text_color"
        android:textSize="30sp"/>
</RelativeLayout>
