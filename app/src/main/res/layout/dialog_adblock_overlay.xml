<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="22dp"
    android:background="@drawable/settings_card_bg">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Shields"
        android:textSize="18sp"
        android:textStyle="bold"
        android:paddingBottom="8dp"/>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingTop="8dp"
        android:paddingBottom="8dp"
        android:focusable="true"
        android:clickable="true"
        android:background="?attr/selectableItemBackground">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/toggle_ads_blocking"
            android:textSize="16sp"/>

        <com.google.android.material.switchmaterial.SwitchMaterial
            android:id="@+id/scShields"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#1F000000"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="8dp"/>

    <TextView
        android:id="@+id/tvShieldsStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="13sp"
        android:textStyle="bold"
        android:paddingBottom="4dp"
        tools:text="SHIELDS ON — Xera"/>

    <TextView
        android:id="@+id/tvMetricsBlockedTab"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="14sp"
        tools:text="Blocked on this page: 12"/>

    <TextView
        android:id="@+id/tvMetricsBlockedTotal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="13sp"
        android:alpha="0.8"
        tools:text="Total blocked: 342"/>

    <TextView
        android:id="@+id/tvMetricsLists"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="13sp"
        android:alpha="0.8"
        android:paddingTop="8dp"
        tools:text="Lists: 5 enabled"/>

    <TextView
        android:id="@+id/tvMetricsLastUpdate"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="12sp"
        android:alpha="0.6"
        tools:text="Last update: never"/>

    <TextView
        android:id="@+id/tvMetricsHost"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="12sp"
        android:alpha="0.6"
        android:paddingTop="4dp"
        tools:text="Host: example.com"/>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#1F000000"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="8dp"/>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Manage"
        android:textSize="14sp"
        android:textStyle="bold"
        android:paddingBottom="4dp"/>

    <TextView
        android:id="@+id/btnManageFilters"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Filter lists"
        android:textSize="14sp"
        android:padding="12dp"
        android:background="?attr/selectableItemBackground"
        android:focusable="true"
        android:clickable="true"
        android:drawableStart="@drawable/ic_refresh_grey_900_24dp"
        android:drawablePadding="12dp"
        android:gravity="center_vertical"/>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="11sp"
        android:alpha="0.5"
        android:paddingTop="8dp"
        android:text="Tap outside to dismiss"/>
</LinearLayout>
